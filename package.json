{
    "name": "ayico-api",
    "version": "1.0.0",
    "description": "API centrale du Raspberry Pi, consommee par toutes les apps",
    "private": true,
    "main": "dist/server.js",
    "scripts": {
        "dev": "tsx watch src/server.ts",
        "build": "tsc",
        "start": "node dist/server.js",
        "migrate:create": "node-pg-migrate create --envPath .env -j sql",
        "migrate:up": "node-pg-migrate up --envPath .env",
        "migrate:down": "node-pg-migrate down --envPath .env"
    },
    "dependencies": {
        "@fastify/jwt": "^9.0.4",
        "bcrypt": "^5.1.1",
        "dotenv": "^16.4.5",
        "fastify": "^5.10.0",
        "pg": "^8.12.0"
    },
    "devDependencies": {
        "@types/bcrypt": "^5.0.2",
        "@types/node": "^20.14.10",
        "@types/pg": "^8.11.6",
        "node-pg-migrate": "^9.0.0",
        "tsx": "^4.16.2",
        "typescript": "^5.5.3"
    }
}
