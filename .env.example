PORT=3000
# Genere avec: openssl rand -hex 32
JWT_SECRET=

# Doit correspondre aux valeurs de /home/ayico/infra/.env
PGHOST=infra_postgres
PGPORT=5432
PGUSER=
PGPASSWORD=
PGDATABASE=

# Utilisee par node-pg-migrate (memes identifiants que ci-dessus)
DATABASE_URL=postgresql://<PGUSER>:<PGPASSWORD>@infra_postgres:5432/<PGDATABASE>
